LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://trading:trading@postgres:5432/trading
CHROMA_HOST=chromadb
CHROMA_PORT=8000
STORAGE_DIR=/app/storage
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Optional: Langfuse tracing (leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM providers: a provider is available when its key (or URL) is set. Model ids look like provider:model
DEFAULT_MODEL=openai:gpt-4o-mini
RESEARCH_MODEL=
STRATEGY_MODEL=
VERIFY_MODEL=
BACKTEST_MODEL=
RISK_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Azure OpenAI: model ids are azure:<deployment name>
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENTS=
OPENROUTER_API_KEY=
# e.g. http://host.docker.internal:11434 (set extra_hosts in compose on Linux) - empty disables Ollama
OLLAMA_BASE_URL=
# Offline scripted "mock:demo" model (no network, no API key) for demos; set DEFAULT_MODEL=mock:demo to use it
ENABLE_MOCK_LLM=false
# Extra "provider:model" ids to list in /models, comma-separated
EXTRA_MODELS=

# RAG (local embeddings, no API key needed)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MODEL_CACHE_DIR=/app/.model_cache
RAG_AUTOINGEST=false
RAG_BUILTIN_DOCS=false

# Upstox historical data import (Analytics Token; expired option candles need an Upstox Plus plan)
# Upstox credentials live in upstox/.env (see upstox/.env.example)

# Market news for the research agent (public RSS feeds). Empty NEWS_FEEDS uses the built-in list (ET, Mint, BS, ...)
NEWS_ENABLED=true
NEWS_FEEDS=
NEWS_MAX_AGE_DAYS=3

# Guardrails: per-user budget limits
LLM_CALLS_PER_MINUTE=12
MAX_ACTIVE_RUNS_PER_USER=2
RUNS_PER_DAY=40

# Agent pipeline
AGENT_TIMEOUT_SECONDS=180
MAX_CONCURRENT_RUNS=2

# Email for the owner account created by otj/seed_users.py (your own; keep the real value only in .env)
OWNER_EMAIL=
